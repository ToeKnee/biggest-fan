#!/bin/sh
# The running daemon is the point of this package: enable and (re)start it
# during install and upgrade so `biggest-fan gui` can reach it without any
# manual systemctl step.
set -e

case "$1" in
    configure)
        systemctl enable biggest-fan.service
        systemctl restart biggest-fan.service
        # Refresh the icon theme cache so the launcher icon shows up
        # immediately (harmless if the tool is not installed).
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
        fi
        ;;
esac
